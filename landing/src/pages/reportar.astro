---
import Base from '../layouts/Base.astro';
import { product } from '../config';
---

<Base title="Reportar un problema | Horarios Escolares" noindex bodyClass="report-body">
  <main class="report-card">
    <div class="brand" style="margin-bottom:22px"><span class="mark" style="width:32px;height:32px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg></span>Horarios Escolares</div>

    <div id="form-view">
      <h1>Reportar un problema</h1>
      <p class="sub">Cuéntanos qué pasó y lo revisamos. Entre más detalle, mejor.</p>
      <div id="err-banner" class="banner" style="display:none">No se pudo enviar el reporte. Revisa tu conexión e inténtalo de nuevo.</div>
      <form method="post" action="/reportar-enviar">
        <label>¿Qué pasó?
          <textarea name="mensaje" required placeholder="Ej: al generar el horario de secundaria aparece un error y no muestra nada."></textarea>
        </label>
        <label>Tu correo o teléfono <small>(opcional, por si necesitamos escribirte)</small>
          <input type="text" name="contacto" placeholder="tucorreo@ejemplo.com" />
        </label>
        <input type="hidden" name="version" id="f-version" value={product.version} />
        <input type="hidden" name="detalle" id="f-detalle" value="" />
        <div class="tech" id="tech"><b>Detalle técnico incluido:</b><br /><code id="tech-txt"></code></div>
        <button type="submit">Enviar reporte</button>
      </form>
      <p class="report-foot"><a href="/">← Volver al inicio</a></p>
    </div>

    <div id="ok-view" style="display:none">
      <div class="ok">
        <div class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 12l6 6L20 6"/></svg></div>
        <h1>¡Reporte enviado!</h1>
        <p class="sub">Gracias por avisarnos. Lo revisamos y, si dejaste contacto, te escribimos.</p>
        <p class="report-foot" style="margin-top:24px"><a href="/">← Volver al inicio</a></p>
      </div>
    </div>
  </main>

  <script is:inline>
    var q = new URLSearchParams(location.search);
    if (q.get('ok') === '1') { document.getElementById('form-view').style.display = 'none'; document.getElementById('ok-view').style.display = 'block'; }
    if (q.get('e') === '1') { document.getElementById('err-banner').style.display = 'block'; }
    var v = q.get('v'); if (v) document.getElementById('f-version').value = v;
    var err = q.get('err');
    if (err) {
      document.getElementById('f-detalle').value = err;
      document.getElementById('tech-txt').textContent = err.slice(0, 300);
      document.getElementById('tech').style.display = 'block';
    }
  </script>
</Base>
